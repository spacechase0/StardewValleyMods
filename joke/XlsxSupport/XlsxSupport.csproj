<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <EnableHarmony>true</EnableHarmony>
  </PropertyGroup>
  <Import Project="$(SolutionDir)common.targets" />

  <PropertyGroup>
    <Name>.xlsx Support</Name>
    <Description>Use .xlsx instead of json. Please don't actually use this.</Description>
    <Version>1.0.0</Version>
    <UpdateKeys>Nexus:</UpdateKeys>

    <BundleExtraAssemblies>System,ThirdParty</BundleExtraAssemblies>
    <IgnoreModFilePatterns>System.*.dll$, ^Microsoft.(?!.*(Bcl.AsyncInterfaces.dll)), ^runtimes/.*, Microsoft.Bcl.AsyncInterfaces.resources.dll$</IgnoreModFilePatterns>
  </PropertyGroup>

  <ItemGroup>
    <Publicize Include="MiniExcel" IncludeVirtualMemebers="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MiniExcel" Version="1.43.0" />
  </ItemGroup>
</Project>
